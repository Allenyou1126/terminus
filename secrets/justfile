default:
    @just --list

# Edit or create one secret (name may include a category subdirectory, e.g.
# `common/foo` or `services/bar`). The editor runs as the current user;
# sudo is only used for agenix decrypt/encrypt.
edit name:
    #!/usr/bin/env bash
    set -Eeuo pipefail

    file="{{name}}"
    agenix_bin="$(command -v agenix)" || {
      echo "agenix not found in PATH" >&2
      exit 1
    }

    cleanup() {
      if [[ -n "${CLEARTEXT_DIR+x}" ]]; then
        rm -rf -- "${CLEARTEXT_DIR}"
      fi
      if [[ -n "${REENCRYPTED_DIR+x}" ]]; then
        rm -rf -- "${REENCRYPTED_DIR}"
      fi
    }
    trap "cleanup" 0 2 3 15

    mkdir -p -- "$(dirname -- "${file}")"

    CLEARTEXT_DIR="$(mktemp -d)"
    CLEARTEXT_FILE="${CLEARTEXT_DIR}/$(basename -- "${file}")"

    if [[ -f "${file}" ]]; then
      sudo "$agenix_bin" -d "${file}" -i /etc/ssh/ssh_host_ed25519_key > "${CLEARTEXT_FILE}"
    else
      : > "${CLEARTEXT_FILE}"
    fi

    ${EDITOR:-vim} "${CLEARTEXT_FILE}"

    # stdin is not a TTY, so agenix internally uses `cp -- /dev/stdin`
    # instead of starting an editor as root.
    sudo "$agenix_bin" -e "${file}" -i /etc/ssh/ssh_host_ed25519_key < "${CLEARTEXT_FILE}"

# Verify that encrypted recipients match agenix-rules.nix.
check:
    #!/usr/bin/env bash
    set -Eeuo pipefail
    agenix_bin="$(command -v agenix)" || {
      echo "agenix not found in PATH" >&2
      exit 1
    }
    "$agenix_bin" -c

# Re-encrypt every rule with its current publicKeys.
rekey:
    #!/usr/bin/env bash
    set -Eeuo pipefail
    agenix_bin="$(command -v agenix)" || {
      echo "agenix not found in PATH" >&2
      exit 1
    }
    sudo "$agenix_bin" -r -i /etc/ssh/ssh_host_ed25519_key

list:
    @find . -type f -name '*.age' -printf '%P\n' | sort
